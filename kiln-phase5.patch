+async fn hash_both(path: &std::path::Path) -> Result<(String, String)> {
+    let p = path.to_path_buf();
+    tokio::task::spawn_blocking(move || super::store::hash_file(&p))
+        .await
+        .map_err(|e| Error::Io(std::io::Error::other(e)))?
+}
