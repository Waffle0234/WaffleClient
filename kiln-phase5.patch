+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Channel {
+    Release,
+    Beta,
+    Alpha,
+}
+
+impl Channel {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Release => "release",
+            Self::Beta => "beta",
+            Self::Alpha => "alpha",
+        }
+    }
+
+    pub fn parse(s: &str) -> Self {
+        match s {
+            "beta" => Self::Beta,
+            "alpha" => Self::Alpha,
+            _ => Self::Release,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Default, Serialize, PartialEq, Eq)]
+pub struct FileHashes {
+    pub sha1: Option<String>,
+    pub sha512: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+pub struct VersionFile {
+    pub url: String,
+    pub filename: String,
+    pub size: u64,
+    pub primary: bool,
+    pub hashes: FileHashes,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq)]
+pub struct ModVersion {
+    pub id: String,
+    pub project_id: String,
+    pub name: String,
+    pub version_number: String,
+    pub changelog: Option<String>,
+    pub channel: Channel,
+    pub game_versions: Vec<String>,
+    pub loaders: Vec<String>,
+    pub date_published: String,
+    pub dependencies: Vec<Dependency>,
+    pub files: Vec<VersionFile>,
+}
+
+impl ModVersion {
+    /// The file to install: the one marked primary, else the first.
+    pub fn primary_file(&self) -> Option<&VersionFile> {
+        self.files
+            .iter()
+            .find(|f| f.primary)
+            .or_else(|| self.files.first())
+    }
+}
+
+/// Which versions are acceptable for an instance. Empty lists mean "any".
+#[derive(Debug, Clone, Default)]
+pub struct VersionFilter {
+    /// Acceptable loader names, in the source's vocabulary (`["quilt", "fabric"]`).
+    pub loaders: Vec<String>,
+    pub game_versions: Vec<String>,
+}
+
+impl VersionFilter {
+    /// The loaders whose mods run on `loader`. Quilt runs most Fabric mods.
+    pub fn for_instance(loader: LoaderKind, mc_version: &str) -> Self {
+        let loaders: &[&str] = match loader {
+            LoaderKind::Vanilla => &[],
+            LoaderKind::Fabric => &["fabric"],
+            LoaderKind::Quilt => &["quilt", "fabric"],
+            LoaderKind::Forge => &["forge"],
+            LoaderKind::Neoforge => &["neoforge"],
+        };
+        Self {
+            loaders: loaders.iter().map(|s| (*s).to_owned()).collect(),
+            game_versions: vec![mc_version.to_owned()],
+        }
+    }
+
+    pub fn accepts(&self, v: &ModVersion) -> bool {
+        let loader_ok =
+            self.loaders.is_empty() || v.loaders.iter().any(|l| self.loaders.contains(l));
+        let game_ok = self.game_versions.is_empty()
+            || v.game_versions
+                .iter()
+                .any(|g| self.game_versions.contains(g));
+        loader_ok && game_ok
+    }
+}
+
+/// A catalogue of downloadable projects.
+pub trait ModSource: Clone + Send + Sync + 'static {
+    /// Stable short name stored in the database (`"modrinth"`).
+    fn name(&self) -> &'static str;
+
+    /// Hosts this source's files may be downloaded from. The install code builds its
+    /// downloader from this and also checks every URL against it before queueing it.
+    fn download_policy(&self) -> HostPolicy;
+
+    fn search(&self, query: &SearchQuery) -> impl Future<Output = Result<SearchPage>> + Send;
+    fn project(&self, id: &str) -> impl Future<Output = Result<Project>> + Send;
+    fn projects(&self, ids: &[String]) -> impl Future<Output = Result<Vec<Project>>> + Send;
+    /// Newest first.
+    fn versions(
+        &self,
+        project: &str,
+        filter: &VersionFilter,
+    ) -> impl Future<Output = Result<Vec<ModVersion>>> + Send;
+    fn version(&self, id: &str) -> impl Future<Output = Result<ModVersion>> + Send;
+    fn versions_by_ids(
+        &self,
+        ids: &[String],
+    ) -> impl Future<Output = Result<Vec<ModVersion>>> + Send;
+    /// Which version each file (by SHA-1) belongs to. Unknown files are absent.
+    fn identify(
+        &self,
+        sha1s: &[String],
+    ) -> impl Future<Output = Result<HashMap<String, ModVersion>>> + Send;
+    /// The newest acceptable version for each file (by SHA-1).
+    fn latest_for(
+        &self,
+        sha1s: &[String],
+        filter: &VersionFilter,
+    ) -> impl Future<Output = Result<HashMap<String, ModVersion>>> + Send;
+}
+
+/// Pick the version to install from a newest-first list: the newest release, else the
+/// newest beta, else the newest alpha.
+pub fn best_version(versions: Vec<ModVersion>) -> Option<ModVersion> {
+    for channel in [Channel::Release, Channel::Beta, Channel::Alpha] {
+        if let Some(v) = versions.iter().find(|v| v.channel == channel) {
+            return Some(v.clone());
+        }
+    }
+    None
+}
+
+/// A file name that is safe to create inside a mods folder.
+pub fn check_jar_name(name: &str) -> Result<&str> {
+    let ok = name.to_ascii_lowercase().ends_with(".jar")
+        && !name.contains(['/', '\\'])
+        && crate::paths::validate_relative(name).is_ok();
+    if ok {
+        Ok(name)
+    } else {
+        Err(Error::InvalidPath("mod file name".into()))
+    }
+}
