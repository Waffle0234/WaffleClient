+<script lang="ts">
+  import { onMount } from 'svelte';
+  import Segmented from '../components/Segmented.svelte';
+  import type { ProjectKind, SortOrder } from '../lib/api';
+  import { formatBytes, progressPercent } from '../lib/format';
+  import { instances } from '../lib/instances.svelte';
+  import { formatCount, planSummary, sourceLine, updateLabel } from '../lib/mods-format';
+  import { mods } from '../lib/mods.svelte';
+  import { router } from '../lib/router.svelte';
+
+  const button =
+    'cursor-pointer rounded-md px-4 py-2 font-medium transition-colors disabled:cursor-not-allowed disabled:opacity-50';
+  const link =
+    'cursor-pointer text-muted underline-offset-2 hover:text-ink hover:underline disabled:opacity-50 disabled:no-underline';
+  const field = 'rounded-md border border-line bg-surface px-3 py-2';
+
+  onMount(() => {
+    void instances.load();
+    void mods.init();
+  });
+
+  const moddable = $derived(instances.list.filter((i) => i.loader !== 'vanilla'));
+  const current = $derived(instances.list.find((i) => i.id === mods.instanceId) ?? null);
+
+  // Pick the first instance that can have mods once the list has loaded.
+  $effect(() => {
+    const first = moddable[0];
+    if (!mods.instanceId && first) void mods.select(first.id);
+  });
+
+  type Tab = 'installed' | 'browse';
+  let tab = $state<Tab>('installed');
+  let kind = $state<ProjectKind>('mod');
+  let query = $state('');
+  let sort = $state<SortOrder>('relevance');
+  let fitInstance = $state(true);
+
+  let confirmRemove = $state<number | null>(null);
+  let showLog = $state<number | null>(null);
+  let confirmPack = $state<string | null>(null);
+  let chosenOptional = $state<string[]>([]);
+
+  const percent = $derived(progressPercent(mods.progress));
+  const updatableCount = $derived(mods.updates.filter((u) => !u.pinned).length);
+
+  function runSearch() {
+    void mods.search(
+      query.trim(),
+      kind,
+      sort,
+      fitInstance && current ? current.mc_version : null,
+      fitInstance && current ? current.loader : null,
+    );
+  }
+
+  function openBrowse() {
+    tab = 'browse';
+    if (!mods.searched) runSearch();
+  }
+
+  async function review(hit: { id: string; title: string }) {
+    chosenOptional = [];
+    await mods.review(hit);
+  }
+
+  function toggleOptional(id: string, on: boolean) {
+    chosenOptional = on ? [...chosenOptional, id] : chosenOptional.filter((x) => x !== id);
+  }
+
+  async function installPack(id: string, title: string) {
+    confirmPack = null;
+    const made = await mods.installModpack(id, title);
+    if (made) {
+      await instances.load();
+      router.go('instances');
+    }
+  }
+
+  const installedProjects = $derived(new Set(mods.installed.map((m) => m.project_id).filter((p): p is string => !!p)));
+</script>
+
+<section class="max-w-4xl">
+  <div class="flex flex-wrap items-end justify-between gap-6">
+    <h1 class="font-display text-5xl font-semibold tracking-tight">Mods</h1>
+    {#if instances.list.length > 0}
+      <div>
+        <label class="block text-sm text-muted" for="mods-instance">Instance</label>
+        <select
+          id="mods-instance"
+          class="{field} mt-1 min-w-56"
+          value={mods.instanceId ?? ''}
+          onchange={(e) => void mods.select(e.currentTarget.value || null)}
+        >
+          {#each instances.list as inst (inst.id)}
+            <option value={inst.id} disabled={inst.loader === 'vanilla'}>
+              {inst.name} ({inst.loader === 'vanilla' ? 'vanilla: no mods' : `${inst.mc_version} ${inst.loader}`})
+            </option>
+          {/each}
+        </select>
+      </div>
+    {/if}
+  </div>
+
+  {#if mods.error}
+    <p role="alert" class="mt-6 rounded-md border border-danger px-4 py-3 text-danger">{mods.error}</p>
+  {/if}
+  {#if mods.notice}
+    <p role="status" class="mt-6 border-l-2 border-accent pl-4 text-muted">{mods.notice}</p>
+  {/if}
+
+  {#if mods.busy && mods.busy !== 'plan' && mods.busy !== 'check'}
+    <div class="mt-6 max-w-xl" role="status">
+      <p>
+        Working…
+        {#if mods.progress && mods.progress.bytes_total > 0}
+          <span class="text-muted">
+            {formatBytes(mods.progress.bytes_done)} of {formatBytes(mods.progress.bytes_total)}
+          </span>
+        {/if}
+      </p>
+      {#if percent !== null}
+        <div
+          class="mt-2 h-1.5 overflow-hidden rounded-full bg-raised"
+          role="progressbar"
+          aria-label="Download progress"
+          aria-valuemin="0"
+          aria-valuemax="100"
+          aria-valuenow={percent}
+        >
+          <div class="h-full bg-accent transition-[width]" style:width="{percent}%"></div>
+        </div>
+      {/if}
+    </div>
+  {/if}
+
+  {#if instances.loaded && instances.list.length === 0}
+    <p class="mt-10 max-w-prose text-lg leading-relaxed">Create an instance first, then come back to add mods to it.</p>
+  {:else if instances.loaded && moddable.length === 0}
+    <p class="mt-10 max-w-prose text-lg leading-relaxed">
+      Mods need a mod loader. Make a Fabric, Quilt, Forge or NeoForge instance on the Instances page.
+    </p>
+  {:else if current}
+    <div class="mt-8 flex flex-wrap items-center gap-4">
+      <Segmented
+        label="Mods view"
+        value={tab}
+        options={[
+          { value: 'installed', label: `Installed (${mods.installed.length})` },
