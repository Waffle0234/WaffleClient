+//! What a mod catalogue must provide, in terms that don't mention any one website, so a
+//! second source (CurseForge) can be added without touching the install logic.
+//!
+//! Everything a source returns is untrusted: identifiers are validated before they are put
+//! in a URL, file names are validated before they touch the disk, and every download URL is
+//! checked against the source's own host allowlist before a request is made.
+
+use std::collections::HashMap;
+use std::future::Future;
+
+use serde::{Deserialize, Serialize};
+
+use crate::loader::LoaderKind;
+use crate::net::HostPolicy;
+use crate::{Error, Result};
+
+/// A project or version id or slug: letters, digits, `-` and `_`, 1 to 64 characters.
+/// Anything else could steer a request at a different API endpoint, so it is refused.
+pub fn is_valid_id(id: &str) -> bool {
+    (1..=64).contains(&id.len())
+        && id
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+}
+
+/// Minecraft versions, categories and similar short labels used in search filters.
+pub fn is_valid_label(s: &str) -> bool {
+    (1..=48).contains(&s.len())
+        && s.chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.' | '+'))
+}
+
+pub fn check_id(id: &str) -> Result<&str> {
+    if is_valid_id(id) {
+        Ok(id)
+    } else {
+        Err(super::ModsError::InvalidId.into())
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ProjectKind {
+    Mod,
+    Modpack,
+    ResourcePack,
+    Shader,
+}
+
+impl ProjectKind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Mod => "mod",
+            Self::Modpack => "modpack",
+            Self::ResourcePack => "resourcepack",
+            Self::Shader => "shader",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Self> {
+        Some(match s {
+            "mod" => Self::Mod,
+            "modpack" => Self::Modpack,
+            "resourcepack" => Self::ResourcePack,
+            "shader" => Self::Shader,
+            _ => return None,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum SortOrder {
+    #[default]
+    Relevance,
+    Downloads,
+    Follows,
+    Newest,
+    Updated,
+}
+
+impl SortOrder {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Relevance => "relevance",
+            Self::Downloads => "downloads",
+            Self::Follows => "follows",
+            Self::Newest => "newest",
+            Self::Updated => "updated",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct SearchQuery {
+    #[serde(default)]
+    pub query: String,
+    pub kind: ProjectKind,
+    #[serde(default)]
+    pub mc_version: Option<String>,
+    #[serde(default)]
+    pub loader: Option<LoaderKind>,
+    #[serde(default)]
+    pub categories: Vec<String>,
+    #[serde(default)]
+    pub sort: SortOrder,
+    #[serde(default)]
+    pub offset: u32,
+    #[serde(default)]
+    pub limit: u32,
+}
+
+impl SearchQuery {
+    /// Reject anything that doesn't look like a plain filter value, and clamp paging.
+    pub fn validated(mut self) -> Result<Self> {
+        self.query = self
+            .query
+            .chars()
+            .filter(|c| !c.is_control())
+            .take(100)
+            .collect();
+        if self
+            .mc_version
+            .as_deref()
+            .is_some_and(|v| !is_valid_label(v))
+            || self.categories.iter().any(|c| !is_valid_label(c))
+            || self.categories.len() > 8
+        {
+            return Err(super::ModsError::InvalidFilter.into());
+        }
+        self.limit = if self.limit == 0 {
+            20
+        } else {
+            self.limit.min(50)
+        };
+        self.offset = self.offset.min(10_000);
+        Ok(self)
+    }
+}
+
