+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ids_are_plain_tokens() {
+        for ok in ["AABBCCDD", "sodium", "fabric-api", "a_b", "x"] {
+            assert!(is_valid_id(ok), "{ok}");
+        }
+        for bad in [
+            "",
+            "a/b",
+            "a b",
+            "..",
+            "a?b",
+            "a#b",
+            "a%2fb",
+            "é",
+            &"x".repeat(65),
+        ] {
+            assert!(!is_valid_id(bad), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn jar_names_cannot_escape_or_be_anything_but_jars() {
+        for ok in ["sodium-0.5.jar", "A.JAR", "a+b.jar"] {
+            assert!(check_jar_name(ok).is_ok(), "{ok}");
+        }
+        for bad in [
+            "../x.jar",
+            "a/b.jar",
+            "a\\b.jar",
+            "x.txt",
+            "x.jar.exe",
+            "CON.jar",
+            "a:b.jar",
+            ".jar.",
+            "x.jar ",
+        ] {
+            assert!(check_jar_name(bad).is_err(), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn the_best_version_prefers_releases_over_newer_betas() {
+        let v = |id: &str, channel| ModVersion {
+            id: id.into(),
+            project_id: "p".into(),
+            name: id.into(),
+            version_number: id.into(),
+            changelog: None,
+            channel,
+            game_versions: vec![],
+            loaders: vec![],
+            date_published: String::new(),
+            dependencies: vec![],
+            files: vec![],
+        };
+        let list = vec![
+            v("new-beta", Channel::Beta),
+            v("old-release", Channel::Release),
+            v("alpha", Channel::Alpha),
+        ];
+        assert_eq!(best_version(list.clone()).unwrap().id, "old-release");
+        assert_eq!(
+            best_version(vec![v("a", Channel::Alpha), v("b", Channel::Beta)])
+                .unwrap()
+                .id,
+            "b"
+        );
+        assert!(best_version(vec![]).is_none());
+    }
+
+    #[test]
+    fn quilt_instances_also_accept_fabric_mods() {
+        let f = VersionFilter::for_instance(LoaderKind::Quilt, "1.20.1");
+        assert_eq!(f.loaders, ["quilt", "fabric"]);
+        assert!(VersionFilter::for_instance(LoaderKind::Forge, "1.20.1").loaders == ["forge"]);
+    }
+}
