+//! A fake Modrinth for tests: one wiremock server that answers the API endpoints Kiln uses
+//! from in-memory data and serves file bytes from `/cdn/`. State is shared, so a test can
+//! publish a new version part-way through.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use serde_json::{json, Value};
+use wiremock::{Mock, MockServer, Request, Respond, ResponseTemplate};
+
+use super::modrinth::Modrinth;
+use super::service::ModService;
+use super::store::ModStore;
+use crate::db::{self, Db};
+use crate::download::{Downloader, RetryPolicy};
+use crate::hash::{hash_bytes, HashAlgo};
+use crate::instance::pack::PackService;
