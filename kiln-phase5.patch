@@ -0,0 +1,1039 @@
+//! Modrinth API v2 as a [`ModSource`].
+//!
+//! Requests go through the allowlisted [`HttpClient`] (host `api.modrinth.com` only).
+//! GET responses are cached by URL with their ETag; a cached copy younger than the TTL is
+//! used without a request at all, which keeps Kiln well inside Modrinth's rate limit.
+//! Rate-limit headers are honoured: when the quota is spent or the server answers 429,
+//! calls wait briefly or fail with a "try again in N seconds" message instead of hammering.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use reqwest::{Method, Url};
+use serde::Deserialize;
+use tokio::sync::Semaphore;
+
+use super::cache::HttpCache;
+use super::source::*;
+use super::{ModsError, CONTACT};
+use crate::net::{Body, HostPolicy, HttpClient, HttpResponse};
+use crate::{Error, Result, APP_NAME, APP_VERSION};
+
+const API_BASE: &str = "https://api.modrinth.com/v2";
+/// Longest a call will sleep for the rate limit before giving up with an error instead.
+const MAX_WAIT: Duration = Duration::from_secs(15);
+/// Cached GET responses younger than this are served without asking Modrinth.
+const DEFAULT_TTL: Duration = Duration::from_secs(300);
+/// Hashes per lookup call. Responses include changelogs, so batches are kept small enough
+/// to stay under the client's response size cap.
+const HASH_BATCH: usize = 25;
+const ID_BATCH: usize = 25;
+
+/// Modrinth asks API clients to say who they are and how to reach them.
+pub fn user_agent() -> String {
+    format!("{APP_NAME}/{APP_VERSION} ({CONTACT})")
+}
+
+pub fn api_policy() -> HostPolicy {
+    HostPolicy::new(&["api.modrinth.com"])
+}
+
+/// Where Modrinth serves files from.
+pub fn download_policy() -> HostPolicy {
+    HostPolicy::new(&["cdn.modrinth.com"])
+}
+
+#[derive(Debug, Default)]
+struct LimitState {
+    blocked_until: Option<Instant>,
+}
+
+#[derive(Debug)]
+struct Limiter {
+    state: Mutex<LimitState>,
+    permits: Semaphore,
+}
+
+impl Limiter {
+    fn new() -> Self {
+        Self {
+            state: Mutex::new(LimitState::default()),
+            permits: Semaphore::new(4),
+        }
+    }
+
+    fn blocked_for(&self) -> Option<Duration> {
+        let s = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        s.blocked_until
+            .and_then(|t| t.checked_duration_since(Instant::now()))
+            .filter(|d| !d.is_zero())
+    }
+
+    /// Wait out a short block, or fail if it is long.
+    async fn wait_turn(&self) -> Result<()> {
+        if let Some(wait) = self.blocked_for() {
+            if wait > MAX_WAIT {
+                return Err(ModsError::RateLimited {
+                    retry_secs: wait.as_secs() + 1,
+                }
+                .into());
+            }
+            tokio::time::sleep(wait).await;
+        }
+        Ok(())
+    }
+
+    fn record(&self, resp: &HttpResponse) {
+        let reset = resp
+            .header("x-ratelimit-reset")
+            .or_else(|| resp.header("retry-after"))
+            .and_then(|v| v.trim().parse::<u64>().ok());
+        let remaining = resp
+            .header("x-ratelimit-remaining")
+            .and_then(|v| v.trim().parse::<u64>().ok());
+        let block = if resp.status == 429 {
+            Some(reset.unwrap_or(60).clamp(1, 300))
+        } else if remaining == Some(0) {
+            Some(reset.unwrap_or(10).clamp(1, 300))
+        } else {
+            None
+        };
+        if let Some(secs) = block {
+            let mut s = self.state.lock().unwrap_or_else(|e| e.into_inner());
+            s.blocked_until = Some(Instant::now() + Duration::from_secs(secs));
+        }
+    }
+}
+
+#[derive(Clone)]
+pub struct Modrinth {
+    http: HttpClient,
+    base: String,
+    cache: Option<HttpCache>,
+    limiter: Arc<Limiter>,
+    ttl: Duration,
+    downloads: HostPolicy,
+}
+
+impl std::fmt::Debug for Modrinth {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Modrinth { .. }")
+    }
+}
+
+impl Modrinth {
+    pub fn new(cache: Option<HttpCache>) -> Result<Self> {
+        Ok(Self::with_client(
+            HttpClient::new(&user_agent(), api_policy())?,
+            API_BASE,
+            cache,
+        ))
+    }
+
+    pub(crate) fn with_client(http: HttpClient, base: &str, cache: Option<HttpCache>) -> Self {
+        Self {
+            http,
+            base: base.trim_end_matches('/').to_owned(),
+            cache,
+            limiter: Arc::new(Limiter::new()),
+            ttl: DEFAULT_TTL,
+            downloads: download_policy(),
+        }
+    }
+
+    /// Test-only: let files be fetched from a loopback mock server.
+    #[cfg(test)]
+    pub(crate) fn with_download_policy(mut self, policy: HostPolicy) -> Self {
+        self.downloads = policy;
+        self
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_ttl(mut self, ttl: Duration) -> Self {
+        self.ttl = ttl;
+        self
+    }
+
+    fn url(&self, path: &str, params: &[(&str, String)]) -> Result<String> {
+        let full = format!("{}{path}", self.base);
+        let url = if params.is_empty() {
+            Url::parse(&full)
+        } else {
+            Url::parse_with_params(&full, params.iter().map(|(k, v)| (*k, v.as_str())))
+        }
+        .map_err(|_| Error::Http("could not build a request".into()))?;
+        Ok(url.into())
+    }
+
+    fn status_error(resp: &HttpResponse) -> Error {
+        match resp.status {
+            404 => ModsError::NotFound.into(),
+            429 => ModsError::RateLimited {
+                retry_secs: resp
+                    .header("x-ratelimit-reset")
+                    .or_else(|| resp.header("retry-after"))
+                    .and_then(|v| v.trim().parse().ok())
+                    .unwrap_or(60),
+            }
+            .into(),
+            other => Error::Http(format!("Modrinth answered with status {other}")),
+        }
+    }
+
+    /// GET with caching. Returns the body bytes.
+    async fn get(&self, url: &str) -> Result<Vec<u8>> {
+        let cached = match &self.cache {
+            Some(c) => c.get(url).await.unwrap_or(None),
+            None => None,
+        };
+        if let Some(c) = &cached {
+            let age = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map_or(i64::MAX, |d| i64::try_from(d.as_secs()).unwrap_or(i64::MAX));
+            if age.saturating_sub(c.fetched_at) < i64::try_from(self.ttl.as_secs()).unwrap_or(0) {
+                return Ok(c.body.clone());
+            }
+        }
+        self.limiter.wait_turn().await?;
+        let _permit = self
+            .limiter
+            .permits
+            .acquire()
+            .await
+            .map_err(|_| Error::Http("the request queue was closed".into()))?;
+        let etag = cached.as_ref().and_then(|c| c.etag.clone());
+        let extra: Vec<(&str, &str)> = etag
+            .as_deref()
+            .map(|e| vec![("If-None-Match", e)])
+            .unwrap_or_default();
+        let resp = self
+            .http
+            .execute_with(Method::GET, url, Body::Empty, None, &extra)
+            .await?;
+        self.limiter.record(&resp);
+        if resp.status == 304 {
+            if let (Some(c), Some(cache)) = (cached, &self.cache) {
+                let _ = cache.touch(url).await;
+                return Ok(c.body);
+            }
+        }
+        if !resp.is_success() {
+            return Err(Self::status_error(&resp));
+        }
+        if let Some(cache) = &self.cache {
+            if let Err(e) = cache.put(url, resp.header("etag"), resp.bytes()).await {
+                tracing::warn!(error = %e, "could not cache a Modrinth response");
+            }
+        }
+        Ok(resp.bytes().to_vec())
+    }
+
+    async fn get_json<T: serde::de::DeserializeOwned>(&self, url: &str) -> Result<T> {
+        let bytes = self.get(url).await?;
+        serde_json::from_slice(&bytes)
+            .map_err(|_| ModsError::BadResponse("unreadable JSON".into()).into())
+    }
+
+    async fn post_json<T: serde::de::DeserializeOwned>(
+        &self,
+        path: &str,
+        body: &serde_json::Value,
+    ) -> Result<T> {
+        let url = self.url(path, &[])?;
+        self.limiter.wait_turn().await?;
+        let _permit = self
+            .limiter
+            .permits
+            .acquire()
+            .await
+            .map_err(|_| Error::Http("the request queue was closed".into()))?;
+        let resp = self
+            .http
+            .execute_with(Method::POST, &url, Body::Json(body), None, &[])
+            .await?;
+        self.limiter.record(&resp);
+        if !resp.is_success() {
+            return Err(Self::status_error(&resp));
+        }
+        resp.json()
+    }
+}
+
+// ---- wire formats -------------------------------------------------------------------
+
+#[derive(Deserialize)]
+struct WireSearch {
+    #[serde(default)]
