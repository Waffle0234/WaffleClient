+}
+
+#[derive(Deserialize, Default)]
+struct WireHashes {
+    #[serde(default)]
+    sha1: Option<String>,
+    #[serde(default)]
+    sha512: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct WireFile {
+    #[serde(default)]
+    hashes: WireHashes,
+    #[serde(default)]
