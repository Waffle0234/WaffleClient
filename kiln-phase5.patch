+    Updated { version_number: String },
+}
+
+/// A project version that has been chosen for installation and checked.
+struct Resolved {
+    project: Project,
+    version: ModVersion,
+    file: VersionFile,
+    reason: &'static str,
+}
+
+enum Target {
+    Project(String),
+    Version(String),
+    /// A version already chosen by the caller (an update): installed even though the
+    /// project is already present.
+    Given(Box<ModVersion>),
+}
+
+fn truncate(s: Option<String>) -> Option<String> {
+    s.map(|c| c.chars().take(MAX_CHANGELOG_CHARS).collect())
+}
+
+fn expected_hash(f: &VersionFile) -> Result<ExpectedHash> {
+    match (&f.hashes.sha512, &f.hashes.sha1) {
+        (Some(h), _) => ExpectedHash::new(HashAlgo::Sha512, h),
+        (None, Some(h)) => ExpectedHash::new(HashAlgo::Sha1, h),
+        _ => Err(ModsError::NoFile(f.filename.clone()).into()),
+    }
+}
