+    #[serde(default)]
+    dependencies: Vec<WireDependency>,
+    #[serde(default)]
+    files: Vec<WireFile>,
+}
+
+fn hex_of(value: Option<String>, len: usize) -> Option<String> {
+    value
+        .map(|h| h.to_ascii_lowercase())
+        .filter(|h| h.len() == len && h.chars().all(|c| c.is_ascii_hexdigit()))
+}
+
+impl From<WireVersion> for ModVersion {
+    fn from(v: WireVersion) -> Self {
+        Self {
+            id: v.id,
+            project_id: v.project_id,
+            name: v.name,
+            version_number: v.version_number,
+            changelog: v.changelog.filter(|c| !c.trim().is_empty()),
+            channel: Channel::parse(&v.version_type),
+            game_versions: v.game_versions,
+            loaders: v.loaders,
+            date_published: v.date_published,
+            dependencies: v
+                .dependencies
+                .into_iter()
+                .filter_map(|d| {
+                    let kind = match d.dependency_type.as_str() {
+                        "required" => DependencyKind::Required,
+                        "optional" => DependencyKind::Optional,
+                        "incompatible" => DependencyKind::Incompatible,
+                        "embedded" => DependencyKind::Embedded,
+                        _ => return None,
+                    };
+                    Some(Dependency {
+                        project_id: d.project_id.filter(|p| is_valid_id(p)),
+                        version_id: d.version_id.filter(|p| is_valid_id(p)),
+                        kind,
+                    })
+                })
+                .collect(),
+            files: v
+                .files
+                .into_iter()
+                .map(|f| VersionFile {
+                    url: f.url,
+                    filename: f.filename,
+                    size: f.size,
+                    primary: f.primary,
+                    hashes: FileHashes {
+                        sha1: hex_of(f.hashes.sha1, 40),
+                        sha512: hex_of(f.hashes.sha512, 128),
+                    },
+                })
+                .collect(),
+        }
+    }
+}
+
+fn json_list(items: &[String]) -> String {
+    serde_json::to_string(items).unwrap_or_else(|_| "[]".into())
+}
+
+impl ModSource for Modrinth {
+    fn name(&self) -> &'static str {
+        "modrinth"
+    }
+
+    fn download_policy(&self) -> HostPolicy {
+        self.downloads.clone()
+    }
+
+    async fn search(&self, q: &SearchQuery) -> Result<SearchPage> {
+        let q = q.clone().validated()?;
+        let mut facets: Vec<Vec<String>> = vec![vec![format!("project_type:{}", q.kind.as_str())]];
+        if let Some(v) = &q.mc_version {
+            facets.push(vec![format!("versions:{v}")]);
+        }
+        if q.kind == ProjectKind::Mod {
+            if let Some(loader) = q.loader {
+                let names = VersionFilter::for_instance(loader, "").loaders;
+                if !names.is_empty() {
+                    facets.push(
+                        names
+                            .into_iter()
+                            .map(|n| format!("categories:{n}"))
+                            .collect(),
+                    );
+                }
+            }
+        }
+        for c in &q.categories {
+            facets.push(vec![format!("categories:{c}")]);
+        }
+        let params = [
+            ("query", q.query.clone()),
+            (
+                "facets",
+                serde_json::to_string(&facets)
+                    .map_err(|_| Error::Http("could not build a request".into()))?,
+            ),
+            ("index", q.sort.as_str().to_owned()),
+            ("offset", q.offset.to_string()),
+            ("limit", q.limit.to_string()),
+        ];
+        let url = self.url("/search", &params)?;
+        let wire: WireSearch = self.get_json(&url).await?;
+        Ok(SearchPage {
+            offset: wire.offset,
+            total: wire.total_hits,
+            hits: wire
+                .hits
+                .into_iter()
+                .map(|h| SearchHit {
+                    id: h.project_id,
+                    slug: h.slug,
+                    title: h.title,
+                    description: h.description,
+                    author: h.author,
+                    kind: ProjectKind::parse(&h.project_type).unwrap_or(q.kind),
+                    downloads: h.downloads,
+                    follows: h.follows,
+                    icon_url: h
+                        .icon_url
+                        .filter(|u| u.starts_with("https://cdn.modrinth.com/")),
+                    categories: h.display_categories,
+                    client_side: h.client_side,
+                    server_side: h.server_side,
+                    license: h.license.filter(|l| !l.is_empty()),
+                })
+                .collect(),
+        })
+    }
+
+    async fn project(&self, id: &str) -> Result<Project> {
+        check_id(id)?;
+        self.projects(&[id.to_owned()])
+            .await?
+            .into_iter()
+            .next()
+            .ok_or_else(|| ModsError::NotFound.into())
+    }
+
+    async fn projects(&self, ids: &[String]) -> Result<Vec<Project>> {
+        let mut out = Vec::new();
+        for chunk in ids.chunks(ID_BATCH) {
+            for id in chunk {
+                check_id(id)?;
+            }
+            let url = self.url("/projects", &[("ids", json_list(chunk))])?;
+            let wire: Vec<WireProject> = self.get_json(&url).await?;
+            let teams: Vec<String> = wire
+                .iter()
+                .map(|p| p.team.clone())
+                .filter(|t| is_valid_id(t))
+                .collect();
+            let mut owners: HashMap<String, String> = HashMap::new();
+            if !teams.is_empty() {
+                let url = self.url("/teams", &[("ids", json_list(&teams))])?;
+                // The author is a nicety: a failure here must not hide the project.
+                if let Ok(lists) = self.get_json::<Vec<Vec<WireMember>>>(&url).await {
+                    for (team, members) in teams.iter().zip(lists) {
+                        let owner = members
+                            .iter()
+                            .find(|m| m.role.eq_ignore_ascii_case("owner"))
+                            .or_else(|| members.first());
+                        if let Some(m) = owner {
+                            owners.insert(team.clone(), m.user.username.clone());
+                        }
+                    }
+                }
+            }
+            for p in wire {
+                out.push(Project {
+                    author: owners.get(&p.team).cloned(),
+                    kind: ProjectKind::parse(&p.project_type).unwrap_or(ProjectKind::Mod),
+                    id: p.id,
+                    slug: p.slug,
+                    title: p.title,
+                    description: p.description,
+                    body: p.body,
+                    downloads: p.downloads,
+                    follows: p.followers,
+                    icon_url: p
+                        .icon_url
+                        .filter(|u| u.starts_with("https://cdn.modrinth.com/")),
+                    license: p.license.map(|l| License {
+                        id: l.id,
+                        name: l.name,
+                        url: l.url.filter(|u| u.starts_with("https://")),
+                    }),
+                    categories: p.categories,
+                    loaders: p.loaders,
+                    game_versions: p.game_versions,
+                    client_side: p.client_side,
+                    server_side: p.server_side,
+                });
+            }
+        }
+        Ok(out)
+    }
+
+    async fn versions(&self, project: &str, filter: &VersionFilter) -> Result<Vec<ModVersion>> {
+        check_id(project)?;
+        let mut params = Vec::new();
+        if !filter.loaders.is_empty() {
+            params.push(("loaders", json_list(&filter.loaders)));
+        }
+        if !filter.game_versions.is_empty() {
+            params.push(("game_versions", json_list(&filter.game_versions)));
+        }
+        let url = self.url(&format!("/project/{project}/version"), &params)?;
+        let wire: Vec<WireVersion> = self.get_json(&url).await?;
+        Ok(wire.into_iter().map(Into::into).collect())
+    }
+
+    async fn version(&self, id: &str) -> Result<ModVersion> {
+        check_id(id)?;
+        let url = self.url(&format!("/version/{id}"), &[])?;
+        let wire: WireVersion = self.get_json(&url).await?;
+        Ok(wire.into())
+    }
+
+    async fn versions_by_ids(&self, ids: &[String]) -> Result<Vec<ModVersion>> {
+        let mut out = Vec::new();
+        for chunk in ids.chunks(ID_BATCH) {
+            for id in chunk {
+                check_id(id)?;
+            }
+            let url = self.url("/versions", &[("ids", json_list(chunk))])?;
+            let wire: Vec<WireVersion> = self.get_json(&url).await?;
+            out.extend(wire.into_iter().map(ModVersion::from));
+        }
+        Ok(out)
+    }
+
+    async fn identify(&self, sha1s: &[String]) -> Result<HashMap<String, ModVersion>> {
+        let mut out = HashMap::new();
+        for chunk in sha1s.chunks(HASH_BATCH) {
+            let body = serde_json::json!({ "hashes": chunk, "algorithm": "sha1" });
+            let found: HashMap<String, WireVersion> =
+                self.post_json("/version_files", &body).await?;
+            out.extend(
+                found
+                    .into_iter()
+                    .map(|(h, v)| (h.to_ascii_lowercase(), v.into())),
+            );
+        }
+        Ok(out)
+    }
+
+    async fn latest_for(
+        &self,
+        sha1s: &[String],
+        filter: &VersionFilter,
+    ) -> Result<HashMap<String, ModVersion>> {
+        let mut out = HashMap::new();
+        for chunk in sha1s.chunks(HASH_BATCH) {
+            let body = serde_json::json!({
+                "hashes": chunk,
+                "algorithm": "sha1",
+                "loaders": filter.loaders,
+                "game_versions": filter.game_versions,
+            });
+            let found: HashMap<String, WireVersion> =
+                self.post_json("/version_files/update", &body).await?;
+            out.extend(
+                found
+                    .into_iter()
+                    .map(|(h, v)| (h.to_ascii_lowercase(), v.into())),
+            );
+        }
+        Ok(out)
+    }
+}
