+//! Mods on disk and in the `mods` table: scanning an instance's mods folder, tracking which
+//! jars came from Modrinth, pinning, enabling, and the backups that make an update
+//! reversible. No network access lives here, so the launch manager can use it to roll back
+//! a bad update without depending on any mod source.
+
+use std::collections::{HashMap, HashSet};
+use std::io::Read;
+use std::path::Path;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use sqlx::FromRow;
+
+use super::source::check_jar_name;
+use super::ModsError;
+use crate::db::Db;
+use crate::hash::{HashAlgo, StreamHasher};
+use crate::instance::InstanceStore;
+use crate::paths::SafePath;
+use crate::{Error, Result};
+
+/// A game that exits abnormally this soon after it started counts as "failed to start".
+pub const STARTUP_WINDOW: Duration = Duration::from_secs(120);
+/// Confirmed update backups kept per instance; older ones are deleted with their files.
+const KEEP_CONFIRMED: i64 = 20;
+
+fn now() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| i64::try_from(d.as_secs()).unwrap_or(0))
+}
+
+const COLUMNS: &str = "id, file_name, sha1, sha512, source, project_id, version_id, pinned, \
+    enabled, size, mtime, title, author, license, downloads, icon_url, version_number, channel, \
+    lookup_at, installed_as";
+
+/// One tracked jar. `file_name` is the name without any `.disabled` suffix.
+#[derive(Debug, Clone, FromRow, Serialize, Deserialize, PartialEq)]
+pub struct ModEntry {
+    pub id: i64,
+    pub file_name: String,
+    pub sha1: String,
+    pub sha512: Option<String>,
+    /// `modrinth` or `unverified`.
+    pub source: String,
+    pub project_id: Option<String>,
+    pub version_id: Option<String>,
+    pub pinned: bool,
+    pub enabled: bool,
+    pub size: Option<i64>,
+    pub mtime: Option<i64>,
+    pub title: Option<String>,
+    pub author: Option<String>,
+    pub license: Option<String>,
+    pub downloads: Option<i64>,
+    pub icon_url: Option<String>,
+    pub version_number: Option<String>,
+    pub channel: Option<String>,
+    #[serde(skip)]
+    pub lookup_at: Option<i64>,
+    pub installed_as: String,
+}
+
+impl ModEntry {
+    pub fn is_modrinth(&self) -> bool {
+        self.source == "modrinth"
+    }
+}
+
+/// What the catalogue knows about a jar.
+#[derive(Debug, Clone, Default)]
+pub struct SourceInfo {
+    pub project_id: String,
+    pub version_id: String,
+    pub version_number: String,
+    pub channel: String,
+    pub title: Option<String>,
+    pub author: Option<String>,
+    pub license: Option<String>,
+    pub downloads: Option<i64>,
+    pub icon_url: Option<String>,
+}
+
+/// A jar Kiln has just written, to be recorded.
+#[derive(Debug, Clone, Copy)]
+pub struct InstallRecord<'a> {
+    pub file_name: &'a str,
+    pub info: &'a SourceInfo,
+    pub sha1: &'a str,
+    pub sha512: Option<&'a str>,
+    pub installed_as: &'a str,
+    pub pinned: bool,
+}
+
+#[derive(Debug, Clone, Default, Serialize, PartialEq, Eq)]
+pub struct RollbackReport {
+    pub instance_id: String,
+    /// File names put back to the version they were before the update.
+    pub restored: Vec<String>,
+    /// File names of mods that an update had added, now removed again.
+    pub removed: Vec<String>,
+    /// Things that could not be undone.
+    pub failed: Vec<String>,
+}
+
+impl RollbackReport {
+    pub fn is_empty(&self) -> bool {
+        self.restored.is_empty() && self.removed.is_empty() && self.failed.is_empty()
+    }
+}
+
+pub fn disk_name(file_name: &str, enabled: bool) -> String {
+    if enabled {
+        file_name.to_owned()
+    } else {
+        format!("{file_name}.disabled")
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ModStore {
+    db: Db,
+    instances: InstanceStore,
+    backups_dir: std::path::PathBuf,
+    window: Duration,
+}
+
+struct Scanned {
+    base: String,
+    enabled: bool,
+    size: i64,
+    mtime: i64,
+    /// `None` when size and mtime match what is already recorded.
+    hashes: Option<(String, String)>,
+}
+
+pub(crate) fn hash_file(path: &Path) -> Result<(String, String)> {
+    let mut file = std::fs::File::open(path)?;
+    let mut sha1 = StreamHasher::new(HashAlgo::Sha1);
+    let mut sha512 = StreamHasher::new(HashAlgo::Sha512);
+    let mut buf = vec![0u8; 64 * 1024];
+    loop {
+        let n = file.read(&mut buf)?;
+        if n == 0 {
+            break;
+        }
+        sha1.update(&buf[..n]);
+        sha512.update(&buf[..n]);
+    }
+    Ok((sha1.finalize_hex(), sha512.finalize_hex()))
+}
+
+fn mtime_of(meta: &std::fs::Metadata) -> i64 {
+    meta.modified()
+        .ok()
+        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+        .map_or(0, |d| i64::try_from(d.as_secs()).unwrap_or(0))
+}
+
+/// Copy `src` to `dest` through a `.part` file so `dest` is never half-written.
+fn copy_atomic(src: &Path, dest: &SafePath) -> Result<()> {
+    let mut part = dest.as_path().as_os_str().to_owned();
+    part.push(".part");
+    let part = std::path::PathBuf::from(part);
+    if let Some(parent) = dest.as_path().parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    std::fs::copy(src, &part)?;
+    std::fs::rename(&part, dest.as_path())?;
+    Ok(())
+}
+
+impl ModStore {
+    pub fn new(db: Db, instances: InstanceStore, backups_dir: &Path) -> Self {
+        Self {
+            db,
+            instances,
+            backups_dir: backups_dir.to_path_buf(),
+            window: STARTUP_WINDOW,
+        }
+    }
+
+    pub fn with_startup_window(mut self, window: Duration) -> Self {
+        self.window = window;
+        self
+    }
+
+    pub fn startup_window(&self) -> Duration {
+        self.window
+    }
+
+    pub fn instances(&self) -> &InstanceStore {
+        &self.instances
+    }
+
+    pub async fn mods_dir(&self, instance_id: &str) -> Result<SafePath> {
+        let game = self.instances.game_dir(instance_id).await?;
+        SafePath::new(game.as_path(), "mods")
+    }
+
+    async fn file_path(
+        &self,
+        instance_id: &str,
+        file_name: &str,
+        enabled: bool,
+    ) -> Result<SafePath> {
+        check_jar_name(file_name)?;
+        let dir = self.mods_dir(instance_id).await?;
+        SafePath::new(dir.as_path(), &disk_name(file_name, enabled))
+    }
+
+    // ---- queries --------------------------------------------------------------------
+
+    pub async fn list(&self, instance_id: &str) -> Result<Vec<ModEntry>> {
+        Ok(sqlx::query_as(&format!(
+            "SELECT {COLUMNS} FROM mods WHERE instance_id = ?1
+             ORDER BY COALESCE(title, file_name) COLLATE NOCASE"
+        ))
+        .bind(instance_id)
+        .fetch_all(&self.db)
+        .await?)
+    }
+
+    pub async fn get(&self, instance_id: &str, mod_id: i64) -> Result<ModEntry> {
+        let row: Option<ModEntry> = sqlx::query_as(&format!(
+            "SELECT {COLUMNS} FROM mods WHERE instance_id = ?1 AND id = ?2"
+        ))
+        .bind(instance_id)
+        .bind(mod_id)
+        .fetch_optional(&self.db)
+        .await?;
+        row.ok_or_else(|| ModsError::UnknownMod.into())
+    }
+
+    pub async fn find_by_file(
+        &self,
+        instance_id: &str,
+        file_name: &str,
+    ) -> Result<Option<ModEntry>> {
+        Ok(sqlx::query_as(&format!(
+            "SELECT {COLUMNS} FROM mods WHERE instance_id = ?1 AND file_name = ?2"
+        ))
+        .bind(instance_id)
+        .bind(file_name)
+        .fetch_optional(&self.db)
+        .await?)
+    }
+
+    pub async fn set_installed_as(&self, mod_id: i64, installed_as: &str) -> Result<()> {
+        sqlx::query("UPDATE mods SET installed_as = ?2 WHERE id = ?1")
+            .bind(mod_id)
+            .bind(installed_as)
+            .execute(&self.db)
+            .await?;
+        Ok(())
+    }
+
+    pub async fn find_by_project(
+        &self,
+        instance_id: &str,
+        project_id: &str,
+    ) -> Result<Option<ModEntry>> {
+        Ok(sqlx::query_as(&format!(
+            "SELECT {COLUMNS} FROM mods WHERE instance_id = ?1 AND project_id = ?2"
+        ))
+        .bind(instance_id)
+        .bind(project_id)
+        .fetch_optional(&self.db)
+        .await?)
+    }
+
+    // ---- scanning -------------------------------------------------------------------
+
+    /// Bring the table in line with the jars in the instance's mods folder. Jars whose size
+    /// and modification time are unchanged are not hashed again.
+    pub async fn sync(&self, instance_id: &str) -> Result<()> {
+        let dir = self.mods_dir(instance_id).await?;
+        let known: HashMap<String, (i64, i64)> = self
+            .list(instance_id)
+            .await?
+            .into_iter()
+            .map(|m| (m.file_name, (m.size.unwrap_or(-1), m.mtime.unwrap_or(-1))))
+            .collect();
+        let path = dir.as_path().to_path_buf();
+        let scanned = tokio::task::spawn_blocking(move || -> Result<Vec<Scanned>> {
+            let mut out = Vec::new();
+            let entries = match std::fs::read_dir(&path) {
+                Ok(e) => e,
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(out),
+                Err(e) => return Err(e.into()),
+            };
+            for entry in entries {
+                let entry = entry?;
+                // A symlinked jar could point anywhere: only plain files are tracked.
+                if !entry.file_type()?.is_file() {
+                    continue;
+                }
+                let name = entry.file_name().to_string_lossy().into_owned();
+                let lower = name.to_ascii_lowercase();
+                let (base, enabled) = if lower.ends_with(".jar") {
+                    (name.clone(), true)
+                } else if lower.ends_with(".jar.disabled") {
+                    (name[..name.len() - ".disabled".len()].to_owned(), false)
+                } else {
+                    continue;
+                };
+                if check_jar_name(&base).is_err() {
+                    continue;
+                }
+                let meta = entry.metadata()?;
+                let (size, mtime) = (
+                    i64::try_from(meta.len()).unwrap_or(i64::MAX),
+                    mtime_of(&meta),
+                );
+                let hashes = if known.get(&base) == Some(&(size, mtime)) {
+                    None
+                } else {
+                    Some(hash_file(&entry.path())?)
+                };
+                out.push(Scanned {
+                    base,
+                    enabled,
+                    size,
+                    mtime,
+                    hashes,
+                });
+            }
+            Ok(out)
+        })
+        .await
+        .map_err(|e| Error::Io(std::io::Error::other(e)))??;
+
+        let present: HashSet<&str> = scanned.iter().map(|s| s.base.as_str()).collect();
+        let mut tx = self.db.begin().await?;
+        for s in &scanned {
+            match &s.hashes {
+                None => {
+                    sqlx::query(
+                        "UPDATE mods SET enabled = ?3 WHERE instance_id = ?1 AND file_name = ?2",
+                    )
+                    .bind(instance_id)
+                    .bind(&s.base)
+                    .bind(s.enabled)
+                    .execute(&mut *tx)
+                    .await?;
+                }
+                Some((sha1, sha512)) => {
+                    // New file, or the jar was replaced: forget what we knew about the old one.
+                    sqlx::query(
+                        "INSERT INTO mods (instance_id, file_name, sha1, sha512, enabled, size, mtime)
+                         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)
+                         ON CONFLICT(instance_id, file_name) DO UPDATE SET
+                            enabled = ?5, size = ?6, mtime = ?7,
+                            sha512 = ?4,
+                            source = CASE WHEN mods.sha1 = ?3 THEN mods.source ELSE 'unverified' END,
+                            project_id = CASE WHEN mods.sha1 = ?3 THEN mods.project_id END,
+                            version_id = CASE WHEN mods.sha1 = ?3 THEN mods.version_id END,
+                            version_number = CASE WHEN mods.sha1 = ?3 THEN mods.version_number END,
+                            channel = CASE WHEN mods.sha1 = ?3 THEN mods.channel END,
+                            title = CASE WHEN mods.sha1 = ?3 THEN mods.title END,
+                            author = CASE WHEN mods.sha1 = ?3 THEN mods.author END,
+                            license = CASE WHEN mods.sha1 = ?3 THEN mods.license END,
+                            downloads = CASE WHEN mods.sha1 = ?3 THEN mods.downloads END,
+                            icon_url = CASE WHEN mods.sha1 = ?3 THEN mods.icon_url END,
+                            lookup_at = CASE WHEN mods.sha1 = ?3 THEN mods.lookup_at END,
+                            sha1 = ?3",
+                    )
+                    .bind(instance_id)
+                    .bind(&s.base)
+                    .bind(sha1)
+                    .bind(sha512)
+                    .bind(s.enabled)
+                    .bind(s.size)
+                    .bind(s.mtime)
+                    .execute(&mut *tx)
+                    .await?;
+                }
+            }
+        }
+        let rows: Vec<(i64, String)> =
+            sqlx::query_as("SELECT id, file_name FROM mods WHERE instance_id = ?1")
+                .bind(instance_id)
+                .fetch_all(&mut *tx)
+                .await?;
+        for (id, name) in rows {
+            if !present.contains(name.as_str()) {
+                sqlx::query("DELETE FROM mods WHERE id = ?1")
+                    .bind(id)
+                    .execute(&mut *tx)
+                    .await?;
+            }
+        }
+        tx.commit().await?;
+        Ok(())
+    }
+
+    /// Jars Modrinth hasn't been asked about in the last day: `(row id, sha1)`.
+    pub async fn unidentified(&self, instance_id: &str) -> Result<Vec<(i64, String)>> {
+        Ok(sqlx::query_as(
+            "SELECT id, sha1 FROM mods
+             WHERE instance_id = ?1 AND source = 'unverified'
+               AND (lookup_at IS NULL OR lookup_at < ?2)",
+        )
+        .bind(instance_id)
+        .bind(now() - 24 * 3600)
+        .fetch_all(&self.db)
+        .await?)
+    }
+
+    pub async fn mark_looked_up(&self, ids: &[i64]) -> Result<()> {
+        for id in ids {
