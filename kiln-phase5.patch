+#[derive(Clone)]
+pub struct ModService<S: ModSource> {
+    source: S,
+    store: ModStore,
+    packs: PackService,
+    downloader: Downloader,
+    /// Scratch space for modpack archives (`imports/`).
+    imports: PathBuf,
+}
+
+impl<S: ModSource> ModService<S> {
+    pub fn new(
+        source: S,
+        store: ModStore,
+        packs: PackService,
+        dirs: &DataDirs,
+        max_concurrent: u8,
+    ) -> Result<Self> {
+        let ua = format!("{APP_NAME}/{APP_VERSION}");
+        let downloader = Downloader::new(
+            HttpClient::new_for_downloads(&ua, source.download_policy())?,
+            max_concurrent,
+        );
+        Ok(Self::with_downloader(
+            source, store, packs, dirs, downloader,
+        ))
+    }
+
+    pub(crate) fn with_downloader(
+        source: S,
+        store: ModStore,
+        packs: PackService,
+        dirs: &DataDirs,
+        downloader: Downloader,
+    ) -> Self {
+        Self {
+            source,
+            store,
+            packs,
+            downloader,
+            imports: dirs.imports.clone(),
+        }
+    }
+
+    pub fn store(&self) -> &ModStore {
+        &self.store
+    }
+
+    pub fn source(&self) -> &S {
+        &self.source
+    }
+
+    fn instances(&self) -> &InstanceStore {
+        self.store.instances()
+    }
+
+    async fn modded_instance(&self, id: &str) -> Result<Instance> {
+        let inst = self.instances().get(id).await?;
+        if inst.loader == LoaderKind::Vanilla {
+            return Err(ModsError::VanillaInstance.into());
+        }
+        Ok(inst)
+    }
+
+    /// A file is only acceptable if its name is a plain `.jar`, its URL is on the source's
+    /// host list, and it carries a hash we can verify.
+    fn pick_file(&self, v: &ModVersion, title: &str) -> Result<VersionFile> {
+        let file = v
+            .primary_file()
+            .ok_or_else(|| ModsError::NoFile(title.to_owned()))?
+            .clone();
+        check_jar_name(&file.filename).map_err(|_| ModsError::NoFile(title.to_owned()))?;
+        expected_hash(&file).map_err(|_| ModsError::NoFile(title.to_owned()))?;
+        let allowed = reqwest::Url::parse(&file.url)
+            .is_ok_and(|u| self.source.download_policy().check(&u).is_ok());
+        if !allowed {
+            return Err(ModsError::NoFile(title.to_owned()).into());
+        }
+        Ok(file)
+    }
+
+    // ---- listing --------------------------------------------------------------------
+
+    /// Tracked mods for an instance. Rescans the folder and asks the source about jars it
+    /// hasn't seen; a network failure there only leaves them marked unverified.
+    pub async fn list(&self, instance_id: &str) -> Result<Vec<ModEntry>> {
+        self.store.sync(instance_id).await?;
+        if let Err(e) = self.identify_unknown(instance_id).await {
+            tracing::warn!(error = %e, "could not identify mods");
+        }
+        self.store.list(instance_id).await
+    }
+
+    async fn identify_unknown(&self, instance_id: &str) -> Result<()> {
+        let rows = self.store.unidentified(instance_id).await?;
+        if rows.is_empty() {
+            return Ok(());
+        }
+        let sha1s: Vec<String> = rows.iter().map(|(_, h)| h.clone()).collect();
+        let found = self.source.identify(&sha1s).await?;
+        let ids: BTreeSet<String> = found.values().map(|v| v.project_id.clone()).collect();
+        let ids: Vec<String> = ids.into_iter().collect();
+        let projects: HashMap<String, Project> = self
+            .source
+            .projects(&ids)
+            .await
+            .unwrap_or_default()
+            .into_iter()
+            .map(|p| (p.id.clone(), p))
+            .collect();
+        for (row_id, sha1) in &rows {
+            if let Some(v) = found.get(sha1) {
+                let info = source_info(v, projects.get(&v.project_id));
+                self.store.set_identified(*row_id, &info).await?;
+            }
+        }
+        let all: Vec<i64> = rows.iter().map(|(id, _)| *id).collect();
+        self.store.mark_looked_up(&all).await
+    }
+
+    // ---- dependency resolution ------------------------------------------------------
+
+    async fn resolve(
+        &self,
+        instance: &Instance,
+        requests: Vec<Target>,
+        installed: &[ModEntry],
+    ) -> Result<(Vec<Resolved>, Vec<OptionalDep>, Vec<Conflict>, Vec<String>)> {
+        let filter = VersionFilter::for_instance(instance.loader, &instance.mc_version);
+        let installed_ids: HashSet<&str> = installed
+            .iter()
+            .filter_map(|m| m.project_id.as_deref())
+            .collect();
+        let mut chosen: Vec<(ModVersion, &'static str)> = Vec::new();
+        let mut chosen_ids: HashSet<String> = HashSet::new();
+        let mut skipped: Vec<String> = Vec::new();
+        let mut optional: BTreeSet<String> = BTreeSet::new();
+        let mut incompatible: Vec<(String, String)> = Vec::new();
+        let mut queue: VecDeque<(Target, usize, &'static str)> =
+            requests.into_iter().map(|t| (t, 0, "requested")).collect();
+
+        while let Some((target, depth, reason)) = queue.pop_front() {
+            if depth > MAX_DEPTH || chosen.len() > MAX_PLAN {
+                return Err(ModsError::TooManyDependencies.into());
+            }
+            let given = matches!(target, Target::Given(_));
+            let version = match target {
+                Target::Given(v) => *v,
+                Target::Project(id) => {
+                    check_id(&id)?;
+                    if chosen_ids.contains(&id) || installed_ids.contains(id.as_str()) {
+                        if installed_ids.contains(id.as_str()) {
+                            skipped.push(id);
+                        }
+                        continue;
+                    }
+                    best_version(self.source.versions(&id, &filter).await?)
+                        .ok_or(ModsError::NoCompatibleVersion(id))?
+                }
+                Target::Version(vid) => {
+                    let v = self.source.version(&vid).await?;
+                    if chosen_ids.contains(&v.project_id)
+                        || installed_ids.contains(v.project_id.as_str())
+                    {
+                        if installed_ids.contains(v.project_id.as_str()) {
+                            skipped.push(v.project_id);
+                        }
+                        continue;
+                    }
+                    if filter.accepts(&v) {
+                        v
+                    } else {
+                        // The pinned version doesn't fit this instance: use the best one that does.
+                        let pid = v.project_id.clone();
+                        best_version(self.source.versions(&pid, &filter).await?)
+                            .ok_or(ModsError::NoCompatibleVersion(pid))?
+                    }
+                }
+            };
+            if chosen_ids.contains(&version.project_id) {
+                continue;
+            }
+            if !given && installed_ids.contains(version.project_id.as_str()) {
+                skipped.push(version.project_id.clone());
+                continue;
+            }
+            for dep in &version.dependencies {
+                match (dep.kind, &dep.project_id, &dep.version_id) {
+                    (DependencyKind::Required, _, Some(vid)) => {
+                        queue.push_back((Target::Version(vid.clone()), depth + 1, "dependency"));
+                    }
+                    (DependencyKind::Required, Some(pid), None) => {
+                        queue.push_back((Target::Project(pid.clone()), depth + 1, "dependency"));
+                    }
+                    (DependencyKind::Optional, Some(pid), _) => {
+                        optional.insert(pid.clone());
+                    }
+                    (DependencyKind::Incompatible, Some(pid), _) => {
+                        incompatible.push((version.project_id.clone(), pid.clone()));
+                    }
+                    _ => {}
+                }
+            }
+            chosen_ids.insert(version.project_id.clone());
+            chosen.push((version, reason));
+        }
+
+        let mut want: BTreeSet<String> = chosen_ids.iter().cloned().collect();
+        want.extend(optional.iter().cloned());
+        want.extend(skipped.iter().cloned());
+        for (owner, bad) in &incompatible {
+            if installed_ids.contains(bad.as_str()) || chosen_ids.contains(bad) {
+                want.insert(owner.clone());
+                want.insert(bad.clone());
+            }
+        }
+        let want: Vec<String> = want.into_iter().collect();
+        let projects: HashMap<String, Project> = self
+            .source
+            .projects(&want)
+            .await?
+            .into_iter()
+            .map(|p| (p.id.clone(), p))
+            .collect();
+        let title_of = |id: &str| {
+            projects
+                .get(id)
+                .map_or_else(|| id.to_owned(), |p| p.title.clone())
+        };
+
+        let mut conflicts = Vec::new();
+        for (owner, bad) in &incompatible {
+            if installed_ids.contains(bad.as_str()) || chosen_ids.contains(bad) {
+                conflicts.push(Conflict {
+                    title: title_of(owner),
+                    conflicts_with: title_of(bad),
+                });
+            }
+        }
+
+        let mut resolved = Vec::new();
+        for (version, reason) in chosen {
+            let project = projects
+                .get(&version.project_id)
+                .cloned()
+                .ok_or_else(|| ModsError::BadResponse("a project was missing".into()))?;
+            let file = self.pick_file(&version, &project.title)?;
+            resolved.push(Resolved {
+                project,
+                version,
+                file,
+                reason,
+            });
+        }
+        let optional = optional
+            .into_iter()
+            .filter(|id| !chosen_ids.contains(id) && !installed_ids.contains(id.as_str()))
+            .map(|id| OptionalDep {
+                title: title_of(&id),
+                project_id: id,
+            })
+            .collect();
+        let skipped = skipped.iter().map(|id| title_of(id)).collect();
+        Ok((resolved, optional, conflicts, skipped))
+    }
+
+    fn to_plan(
+        resolved: &[Resolved],
+        optional: Vec<OptionalDep>,
+        conflicts: Vec<Conflict>,
+        skipped: Vec<String>,
+    ) -> InstallPlan {
+        InstallPlan {
+            mods: resolved
+                .iter()
+                .map(|r| PlannedMod {
+                    project_id: r.project.id.clone(),
+                    title: r.project.title.clone(),
+                    version_id: r.version.id.clone(),
+                    version_number: r.version.version_number.clone(),
+                    channel: r.version.channel,
+                    file_name: r.file.filename.clone(),
+                    size: r.file.size,
+                    reason: r.reason.to_owned(),
+                    icon_url: r.project.icon_url.clone(),
+                })
+                .collect(),
+            optional,
+            conflicts,
+            already_installed: skipped,
+        }
+    }
+
+    /// What installing `project` would do, without doing it.
+    pub async fn plan_install(&self, instance_id: &str, project: &str) -> Result<InstallPlan> {
+        check_id(project)?;
+        let instance = self.modded_instance(instance_id).await?;
+        self.store.sync(instance_id).await?;
+        let installed = self.store.list(instance_id).await?;
+        let (resolved, optional, conflicts, skipped) = self
+            .resolve(
+                &instance,
+                vec![Target::Project(project.to_owned())],
+                &installed,
+            )
+            .await?;
+        Ok(Self::to_plan(&resolved, optional, conflicts, skipped))
+    }
+
+    // ---- install --------------------------------------------------------------------
+
+    /// Install `project` and its required dependencies, plus any of the plan's optional
+    /// dependencies named in `optional`.
+    pub async fn install(
+        &self,
+        instance_id: &str,
+        project: &str,
+        optional: &[String],
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<InstallPlan> {
+        check_id(project)?;
+        let instance = self.modded_instance(instance_id).await?;
+        self.store.sync(instance_id).await?;
+        let installed = self.store.list(instance_id).await?;
+        let mut requests = vec![Target::Project(project.to_owned())];
+        let (mut resolved, mut offered, mut conflicts, mut skipped) =
+            self.resolve(&instance, requests, &installed).await?;
+        if !optional.is_empty() {
+            // Only optional mods the plan itself offered may be added.
+            let offered_ids: HashSet<&str> =
+                offered.iter().map(|o| o.project_id.as_str()).collect();
+            if optional.iter().any(|o| !offered_ids.contains(o.as_str())) {
+                return Err(ModsError::InvalidId.into());
+            }
+            requests = vec![Target::Project(project.to_owned())];
+            requests.extend(optional.iter().map(|o| Target::Project(o.clone())));
+            (resolved, offered, conflicts, skipped) =
+                self.resolve(&instance, requests, &installed).await?;
+        }
+        if let Some(c) = conflicts.first() {
+            return Err(
+                ModsError::Conflict(format!("{} and {}", c.title, c.conflicts_with)).into(),
+            );
+        }
+        let plan = Self::to_plan(&resolved, offered, conflicts, skipped);
+        let wanted_user: HashSet<&str> = std::iter::once(project)
+            .chain(optional.iter().map(String::as_str))
+            .collect();
+        self.write_all(instance_id, &resolved, progress, |r| {
+            if wanted_user.contains(r.project.id.as_str())
+                || wanted_user.contains(r.project.slug.as_str())
+            {
+                "user"
+            } else {
+                "dependency"
+            }
+        })
+        .await?;
+        Ok(plan)
+    }
+
+    /// Download every resolved file into the mods folder and record it.
+    async fn write_all(
+        &self,
+        instance_id: &str,
+        items: &[Resolved],
+        progress: Option<watch::Sender<Progress>>,
+        installed_as: impl Fn(&Resolved) -> &'static str,
+    ) -> Result<()> {
+        let dir = self.store.mods_dir(instance_id).await?;
+        std::fs::create_dir_all(dir.as_path())?;
+        let mut tasks = Vec::new();
+        let mut created: Vec<std::path::PathBuf> = Vec::new();
+        for r in items {
+            let target = SafePath::new(dir.as_path(), &r.file.filename)?;
+            if !target.as_path().exists() {
+                created.push(target.as_path().to_path_buf());
+            }
+            tasks.push(DownloadTask {
+                url: r.file.url.clone(),
+                dest: SafePath::new(dir.as_path(), &r.file.filename)?,
+                hash: Some(expected_hash(&r.file)?),
+                size: (r.file.size > 0).then_some(r.file.size),
+            });
+        }
+        if let Err(e) = self.downloader.download_all(tasks, progress).await {
+            // Downloads run side by side: some files may have landed before another failed.
+            // Don't leave a mod behind without the things it needs.
+            for path in created {
+                let _ = std::fs::remove_file(path);
+            }
+            return Err(e);
+        }
+        for r in items {
+            let path = SafePath::new(dir.as_path(), &r.file.filename)?;
+            let (sha1, sha512) = hash_both(path.as_path()).await?;
+            let info = source_info(&r.version, Some(&r.project));
+            self.store
+                .record_install(
+                    instance_id,
+                    &InstallRecord {
+                        file_name: &r.file.filename,
+                        info: &info,
+                        sha1: &sha1,
+                        sha512: Some(&sha512),
+                        installed_as: installed_as(r),
+                        pinned: false,
+                    },
+                )
+                .await?;
+        }
+        Ok(())
+    }
+
+    // ---- updates --------------------------------------------------------------------
+
+    /// Which tracked Modrinth mods have a newer version for this instance, found by hashing
+    /// the installed jars (so renamed files still match).
+    pub async fn check_updates(&self, instance_id: &str) -> Result<Vec<UpdateInfo>> {
+        let instance = self.modded_instance(instance_id).await?;
+        let entries = self.list(instance_id).await?;
+        let filter = VersionFilter::for_instance(instance.loader, &instance.mc_version);
+        let candidates: Vec<&ModEntry> = entries
+            .iter()
+            .filter(|m| m.is_modrinth() && m.enabled)
+            .collect();
+        if candidates.is_empty() {
+            return Ok(Vec::new());
+        }
+        let sha1s: Vec<String> = candidates.iter().map(|m| m.sha1.clone()).collect();
+        let latest = self.source.latest_for(&sha1s, &filter).await?;
+        let mut out = Vec::new();
+        for m in candidates {
+            let Some(v) = latest.get(&m.sha1) else {
+                continue;
+            };
+            if Some(&v.id) == m.version_id.as_ref() {
+                continue;
+            }
+            // Don't push someone on a release onto a beta.
+            if v.channel != Channel::Release && m.channel.as_deref() == Some("release") {
+                continue;
+            }
+            if v.primary_file().and_then(|f| f.hashes.sha1.as_ref()) == Some(&m.sha1) {
+                continue;
+            }
+            out.push(UpdateInfo {
+                mod_id: m.id,
+                file_name: m.file_name.clone(),
+                title: m.title.clone().unwrap_or_else(|| m.file_name.clone()),
+                current_version: m.version_number.clone(),
+                new_version: v.version_number.clone(),
+                new_version_id: v.id.clone(),
+                channel: v.channel,
+                changelog: truncate(v.changelog.clone()),
+                pinned: m.pinned,
+            });
+        }
+        Ok(out)
+    }
+
+    /// Update one mod. Returns false if it was already current. Pinned mods are refused.
+    pub async fn update_mod(
+        &self,
+        instance_id: &str,
+        mod_id: i64,
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<bool> {
+        let instance = self.modded_instance(instance_id).await?;
+        let entry = self.store.get(instance_id, mod_id).await?;
+        if entry.pinned {
+            return Err(ModsError::Pinned.into());
+        }
+        if !entry.is_modrinth() {
+            return Err(ModsError::UnknownMod.into());
+        }
+        let filter = VersionFilter::for_instance(instance.loader, &instance.mc_version);
+        let latest = self
+            .source
+            .latest_for(std::slice::from_ref(&entry.sha1), &filter)
+            .await?;
+        let Some(version) = latest.get(&entry.sha1).cloned() else {
+            return Ok(false);
+        };
+        if Some(&version.id) == entry.version_id.as_ref() {
+            return Ok(false);
+        }
+        self.apply_update(&instance, &entry, version, progress)
+            .await?;
+        Ok(true)
+    }
+
+    async fn apply_update(
+        &self,
+        instance: &Instance,
+        entry: &ModEntry,
+        version: ModVersion,
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<()> {
+        let installed = self.store.list(&instance.id).await?;
+        let (resolved, _optional, conflicts, _skipped) = self
+            .resolve(instance, vec![Target::Given(Box::new(version))], &installed)
+            .await?;
+        if let Some(c) = conflicts.first() {
+            return Err(
+                ModsError::Conflict(format!("{} and {}", c.title, c.conflicts_with)).into(),
+            );
+        }
+        let main_project = entry.project_id.clone().unwrap_or_default();
+        let main = resolved
+            .iter()
+            .find(|r| r.project.id == main_project)
+            .ok_or_else(|| ModsError::BadResponse("the update was missing".into()))?;
+        // Keep the old jar before anything is written: the new file may reuse its name.
+        let backup_id = self
+            .store
+            .backup_for_update(&instance.id, entry, &main.file.filename)
+            .await?;
+        let written = self
+            .write_all(&instance.id, &resolved, progress, |r| {
+                if r.project.id == main_project {
+                    "user"
+                } else {
+                    "dependency"
+                }
+            })
+            .await;
+        if let Err(e) = written {
+            // Put back anything the failed update touched (a new file may have reused the old
+            // name), then drop the backup record.
+            let _ = self.store.abort_update(&instance.id, backup_id).await;
+            return Err(e);
+        }
+        if main.file.filename != entry.file_name {
+            // Remove the old jar and its row; the backup copy is what rollback restores.
+            self.store.remove(&instance.id, entry.id).await?;
+        }
+        // Carry over what the update must not change about the mod.
+        let fresh = self
+            .store
+            .find_by_file(&instance.id, &main.file.filename)
+            .await?
+            .ok_or(ModsError::UnknownMod)?;
+        if !entry.enabled {
+            self.store
+                .set_enabled(&instance.id, fresh.id, false)
+                .await?;
+        }
+        if entry.installed_as != "user" {
+            self.store
+                .set_installed_as(fresh.id, &entry.installed_as)
+                .await?;
+        }
+        for r in resolved.iter().filter(|r| r.project.id != main_project) {
+            self.store
+                .record_added_by_update(&instance.id, &r.file.filename)
+                .await?;
+        }
+        Ok(())
+    }
+
+    /// Update every mod that has an update and isn't pinned. One failure doesn't stop the rest.
+    pub async fn update_all(
+        &self,
+        instance_id: &str,
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<UpdateAllReport> {
+        let updates = self.check_updates(instance_id).await?;
+        let mut report = UpdateAllReport::default();
+        for u in updates {
+            if u.pinned {
+                report.skipped_pinned += 1;
+                continue;
+            }
+            match self
+                .update_mod(instance_id, u.mod_id, progress.clone())
+                .await
+            {
+                Ok(true) => report.updated.push(u.title),
+                Ok(false) => {}
+                Err(e) => report.failed.push(UpdateFailure {
+                    title: u.title,
+                    message: crate::AppError::from(e).message,
+                }),
+            }
+        }
+        Ok(report)
+    }
+
+    /// Undo the updates made since the game last started successfully.
+    pub async fn rollback(&self, instance_id: &str) -> Result<RollbackReport> {
+        self.instances().get(instance_id).await?;
+        let report = self.store.rollback_pending(instance_id).await?;
+        if report.is_empty() {
+            return Err(ModsError::NothingToRollBack.into());
+        }
+        Ok(report)
+    }
+
+    // ---- modpacks -------------------------------------------------------------------
+
+    async fn fetch_pack_file(&self, version: &ModVersion, slug: &str) -> Result<(String, PathBuf)> {
+        let file = version
+            .files
+            .iter()
+            .find(|f| f.primary && f.filename.to_ascii_lowercase().ends_with(".mrpack"))
+            .or_else(|| {
+                version
+                    .files
+                    .iter()
+                    .find(|f| f.filename.to_ascii_lowercase().ends_with(".mrpack"))
+            })
+            .ok_or_else(|| ModsError::NotAModpack("it has no .mrpack file".into()))?;
+        let allowed = reqwest::Url::parse(&file.url)
+            .is_ok_and(|u| self.source.download_policy().check(&u).is_ok());
+        if !allowed {
+            return Err(ModsError::NotAModpack(
+                "it is hosted somewhere Kiln doesn't download from".into(),
+            )
+            .into());
+        }
+        let safe_slug: String = slug
+            .chars()
+            .filter(|c| c.is_ascii_alphanumeric() || *c == '-')
+            .take(40)
+            .collect();
+        let name = format!(
+            "kiln-{safe_slug}-{}.mrpack",
+            &version.id.chars().take(12).collect::<String>()
+        );
+        let dest = SafePath::new(&self.imports, &name)?;
+        let path = dest.as_path().to_path_buf();
+        self.downloader
+            .download(DownloadTask {
+                url: file.url.clone(),
+                dest,
+                hash: Some(expected_hash(file)?),
+                size: (file.size > 0).then_some(file.size),
+            })
+            .await?;
+        Ok((name, path))
+    }
+
+    /// Install a Modrinth modpack as a new instance. Only the pack's listed files are
+    /// downloaded and its override files unpacked; nothing in a pack is ever run.
+    pub async fn install_modpack(
+        &self,
+        project: &str,
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<Instance> {
+        check_id(project)?;
+        let project = self.source.project(project).await?;
+        if project.kind != ProjectKind::Modpack {
+            return Err(ModsError::NotAModpack("that project isn't a modpack".into()).into());
+        }
+        let version = best_version(
+            self.source
+                .versions(&project.id, &VersionFilter::default())
+                .await?,
+        )
+        .ok_or_else(|| ModsError::NoCompatibleVersion(project.title.clone()))?;
+        let (name, path) = self.fetch_pack_file(&version, &project.slug).await?;
+        let imported = self.packs.import(&name, progress).await;
+        let files = crate::instance::pack::mrpack_installed_paths(&path);
+        let _ = std::fs::remove_file(&path);
+        let instance = imported?;
+        self.store
+            .record_pack(
+                &instance.id,
+                &project.id,
+                &version.id,
+                &version.version_number,
+                &files?,
+            )
+            .await?;
+        Ok(instance)
+    }
+
+    pub async fn check_modpack_update(&self, instance_id: &str) -> Result<Option<PackUpdateInfo>> {
+        let Some(link) = self.store.pack_link(instance_id).await? else {
+            return Err(ModsError::NotAModpack(
+                "this instance wasn't installed from a Modrinth pack".into(),
+            )
+            .into());
+        };
+        let latest = best_version(
+            self.source
+                .versions(&link.project_id, &VersionFilter::default())
+                .await?,
+        );
+        Ok(latest
+            .filter(|v| v.id != link.version_id)
+            .map(|v| PackUpdateInfo {
+                version_id: v.id,
+                version_number: v.version_number,
+                changelog: truncate(v.changelog),
+            }))
+    }
+
+    /// Move the instance to the pack's newest version. Files the old pack put there and the
+    /// new one doesn't are removed (kept in the backups folder); files you added yourself
+    /// are never overwritten or removed.
+    pub async fn update_modpack(
+        &self,
+        instance_id: &str,
+        progress: Option<watch::Sender<Progress>>,
+    ) -> Result<PackUpdateOutcome> {
+        let Some(link) = self.store.pack_link(instance_id).await? else {
+            return Err(ModsError::NotAModpack(
+                "this instance wasn't installed from a Modrinth pack".into(),
+            )
+            .into());
+        };
+        let project = self.source.project(&link.project_id).await?;
+        let version = best_version(
+            self.source
+                .versions(&project.id, &VersionFilter::default())
+                .await?,
+        )
+        .ok_or_else(|| ModsError::NoCompatibleVersion(project.title.clone()))?;
+        if version.id == link.version_id {
+            return Ok(PackUpdateOutcome::UpToDate);
+        }
+        let (name, path) = self.fetch_pack_file(&version, &project.slug).await?;
+        let applied = self
+            .packs
+            .apply_update(instance_id, &name, &link.files, progress)
+            .await;
+        let _ = std::fs::remove_file(&path);
+        let files = applied?;
+        self.store
+            .record_pack(
+                instance_id,
+                &project.id,
+                &version.id,
+                &version.version_number,
+                &files,
+            )
+            .await?;
+        self.store.sync(instance_id).await?;
+        Ok(PackUpdateOutcome::Updated {
+            version_number: version.version_number,
+        })
+    }
+
+    // ---- export ---------------------------------------------------------------------
+
+    /// Export as `.mrpack`. Mods Modrinth knows are listed with their hashes and download
+    /// URLs rather than copied in; other jars are bundled and reported.
+    pub async fn export_mrpack(&self, instance_id: &str) -> Result<MrpackExport> {
+        let entries = self.list(instance_id).await?;
+        let known: Vec<&ModEntry> = entries
+            .iter()
+            .filter(|m| m.is_modrinth() && m.enabled && m.version_id.is_some())
+            .collect();
+        let version_ids: Vec<String> = known.iter().filter_map(|m| m.version_id.clone()).collect();
+        let versions: HashMap<String, ModVersion> = self
+            .source
+            .versions_by_ids(&version_ids)
+            .await?
+            .into_iter()
+            .map(|v| (v.id.clone(), v))
+            .collect();
+        let project_ids: Vec<String> = known.iter().filter_map(|m| m.project_id.clone()).collect();
+        let projects: HashMap<String, Project> = self
+            .source
+            .projects(&project_ids)
+            .await?
+            .into_iter()
+            .map(|p| (p.id.clone(), p))
+            .collect();
+        let mut listed = Vec::new();
+        let mut listed_names = HashSet::new();
+        for m in &known {
+            let (Some(vid), Some(pid)) = (&m.version_id, &m.project_id) else {
+                continue;
+            };
+            let Some(file) = versions.get(vid).and_then(|v| {
+                v.files
+                    .iter()
+                    .find(|f| f.hashes.sha1.as_deref() == Some(m.sha1.as_str()))
+            }) else {
+                continue;
+            };
+            let (Some(sha1), Some(sha512)) = (&file.hashes.sha1, &file.hashes.sha512) else {
+                continue;
+            };
+            let allowed = reqwest::Url::parse(&file.url)
+                .is_ok_and(|u| self.source.download_policy().check(&u).is_ok());
+            if !allowed {
+                continue;
+            }
+            let p = projects.get(pid);
+            listed_names.insert(format!("mods/{}", m.file_name));
+            listed.push(MrpackFile {
+                path: format!("mods/{}", m.file_name),
+                sha1: sha1.clone(),
+                sha512: sha512.clone(),
+                size: file.size,
+                url: file.url.clone(),
+                client_env: p
+                    .map_or("required", |p| env_value(&p.client_side))
+                    .to_owned(),
+                server_env: p
+                    .map_or("required", |p| env_value(&p.server_side))
+                    .to_owned(),
+            });
+        }
+        let bundled_unverified: Vec<String> = entries
+            .iter()
+            .filter(|m| !listed_names.contains(&format!("mods/{}", m.file_name)))
+            .map(|m| disk_name(&m.file_name, m.enabled))
+            .collect();
+        let count = listed.len();
+        let file = self.packs.export_mrpack_with(instance_id, listed).await?;
+        Ok(MrpackExport {
+            file,
+            listed: count,
+            bundled_unverified,
+        })
+    }
+}
+
+fn env_value(side: &str) -> &'static str {
+    match side {
+        "optional" => "optional",
+        "unsupported" => "unsupported",
+        _ => "required",
+    }
+}
+
+fn source_info(v: &ModVersion, p: Option<&Project>) -> SourceInfo {
+    SourceInfo {
+        project_id: v.project_id.clone(),
+        version_id: v.id.clone(),
+        version_number: v.version_number.clone(),
+        channel: v.channel.as_str().to_owned(),
+        title: p.map(|p| p.title.clone()),
+        author: p.and_then(|p| p.author.clone()),
+        license: p.and_then(|p| p.license.as_ref().map(|l| l.name.clone())),
+        downloads: p.map(|p| i64::try_from(p.downloads).unwrap_or(i64::MAX)),
+        icon_url: p.and_then(|p| p.icon_url.clone()),
+    }
+}
